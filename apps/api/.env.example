# Copy to apps/api/.env (gitignored) for `pnpm dev`; wrangler reads it automatically. Never commit the real key.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Local dev: the browser's Origin is the Vite dev server, so allow it (overrides the GitHub Pages value in wrangler.toml).
ALLOWED_ORIGIN=http://localhost:5173
